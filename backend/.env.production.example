# 1. DATABASE (Supabase Transaction Pooler - Session Mode - Port 5432)
# Khuyến nghị dùng Pooler port 5432 hoặc 6543 để hỗ trợ IPv4 trên Render Free
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# 2. CORS (Cho phép frontend truy cập API)
