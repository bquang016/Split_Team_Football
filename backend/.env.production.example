# 3. SECURITY & JWT (Tối thiểu 32 ký tự)
JWT_SECRET=chimmoccanh-jwt-secret-key-minimum-32-characters-long-2026
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

